+    def on_cache_reset(self) -> None: ...
+
+    def propose(
+        self, count: int, protected_block_ids: Iterable[int] = ()
+    ) -> tuple[int, ...] | None: ...
+
+
+class _MoriSimpleCPUProviderBridge:
+    """Forward BlockPool events while maintaining O(1) residency facts."""
+
+    HOOK_API_VERSION = 1
+
+    def __init__(
+        self,
+        delegate: MoriSimpleCPUVictimProvider,
+        resident_block_ids: set[int],
+    ) -> None:
+        self.delegate = delegate
+        self.resident_block_ids = resident_block_ids
+
+    def on_block_ready(self, block_id: int, native_lru_seq: int) -> None:
+        self.delegate.on_block_ready(block_id, native_lru_seq)
+
+    def on_block_owner_added(self, block_id: int, request_id: str) -> None:
+        self.delegate.on_block_owner_added(block_id, request_id)
+
+    def on_block_evictability_changed(self, block_id: int, ready: bool) -> None:
+        self.delegate.on_block_evictability_changed(block_id, ready)
+
+    def on_block_removed(self, block_id: int) -> None:
+        self.resident_block_ids.discard(block_id)
+        self.delegate.on_block_removed(block_id)
+
+    def on_cache_reset(self) -> None:
+        self.resident_block_ids.clear()
+        self.delegate.on_cache_reset()
+
+    def propose(
+        self, count: int, protected_block_ids: Iterable[int] = ()
+    ) -> tuple[int, ...] | None:
+        return self.delegate.propose(count, protected_block_ids)
+
